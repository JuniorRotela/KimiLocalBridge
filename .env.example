# Optional: export these variables in your shell before running npm start.
# This file is an example; the bridge reads process environment variables directly.
PORT=4000
HOST=127.0.0.1
WORKERS=2
HEADLESS=false
PROFILE_DIR=./nvidia-profile
MODEL_ID=moonshotai/kimi-k3_1-pro
UPSTREAM_MODEL=moonshotai/kimi-k3.1-pro
PLAYGROUND_URL=https://build.nvidia.com/moonshotai/kimi-k3_1-pro/playground
REASONING_EFFORT=low
CONCISE_RESPONSES=true
MAX_TOKENS=65536
RESET_AFTER_TURNS=40
DEBUG=false
